{
	"name": "@nodecraft/rendermite",
	"version": "0.0.0-semantically-released",
	"description": "Minecraft item icon renderer: renders inventory-identical item icons from vanilla and modded assets across game versions, outputting optimized PNG/WebP/AVIF plus CSS and a JSON item library.",
	"type": "module",
	"license": "MIT",
	"author": "Nodecraft",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nodecraft/rendermite.git"
	},
	"homepage": "https://github.com/nodecraft/rendermite#readme",
	"bugs": {
		"url": "https://github.com/nodecraft/rendermite/issues"
	},
	"keywords": [
		"minecraft",
		"icons",
		"renderer",
		"resource-pack",
		"webp",
		"sprites"
	],
	"bin": {
		"rendermite": "./dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"assets"
	],
	"publishConfig": {
		"access": "restricted"
	},
	"scripts": {
		"build": "rimraf dist && tsdown",
		"lint": "eslint . --fix",
		"lint:ci": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"semantic-release": "semantic-release"
	},
	"engines": {
		"node": ">=24",
		"npm": ">=11"
	},
	"dependencies": {
		"lightningcss": "1.33.0",
		"sharp": "0.35.3",
		"yauzl": "3.4.0"
	},
	"devDependencies": {
		"@nodecraft/eslint-config": "50.2.0",
		"@semantic-release/changelog": "7.0.0",
		"@types/node": "24.13.3",
		"@types/yauzl": "3.4.0",
		"@types/yazl": "3.3.1",
		"eslint": "10.8.0",
		"rimraf": "6.1.3",
		"semantic-release": "25.0.9",
		"tsdown": "0.22.14",
		"typescript": "6.0.3",
		"typescript-eslint": "8.66.0",
		"vitest": "4.1.10",
		"yazl": "3.3.1"
	}
}
