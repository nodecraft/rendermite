{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "rendermite-website",
	"compatibility_date": "2026-10-01",
	"send_metrics": false,
	// Static assets only: no Worker script runs, so there is no code path to exploit beyond file serving.
	"assets": {
		"directory": "./public",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	},
	"routes": [
		{ "pattern": "rendermite.dev", "custom_domain": true }
	],
	// Only the custom domain serves the site; no *.workers.dev or preview copies to keep in sync.
	"workers_dev": false,
	"preview_urls": false
}
